# RAG Chatbot - Environment Configuration
# Kopiera denna fil till .env och fyll i dina värden
# OBS: .env är i .gitignore och kommer INTE committas till Git

# === Database Configuration ===
# Välj ETT av alternativen nedan

# Alternativ 1: Windows Authentication (Trusted Connection)
# RAG_DB_DRIVER=ODBC Driver 17 for SQL Server
# RAG_DB_SERVER=DIN_SERVER
# RAG_DB_DATABASE=DIN_DATABAS
# RAG_DB_TRUSTED_CONNECTION=yes

# Alternativ 2: SQL Server Authentication
# RAG_DB_DRIVER=ODBC Driver 17 for SQL Server
# RAG_DB_SERVER=DIN_SERVER
# RAG_DB_DATABASE=DIN_DATABAS
# RAG_DB_USERNAME=DIN_ANVÄNDARE
# RAG_DB_PASSWORD=DITT_LÖSENORD

# === API Configuration (Optional) ===
RAG_API_PORT=5000
RAG_LLM_API_URL=http://localhost:1234/v1/chat/completions
RAG_LLM_MODEL=lmstudio-community/Meta-Llama-3-8B-Instruct-GGUF

# === Security Settings ===
RAG_MAX_INPUT_LENGTH=5000
RAG_API_RATE_LIMIT=10
